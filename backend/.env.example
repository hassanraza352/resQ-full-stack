# ---- Optional (defaults shown) ----
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS + CSRF origin check + Socket.IO)
CLIENT_ORIGIN=http://localhost:5173
# Behind a reverse proxy (Render/Nginx/Heroku) set to 1 so rate limiting sees real client IPs
TRUST_PROXY=0
# lax (same-site frontend/backend) | none (frontend and backend on different sites; requires HTTPS)
COOKIE_SAMESITE=lax

# Dispatch / geo
NEARBY_DEFAULT_RADIUS_KM=15
NEARBY_MAX_RADIUS_KM=50
# a unit's GPS point older than this is treated as stale and excluded from "available" discovery
UNIT_LOCATION_MAX_AGE_MIN=15

# Routing (any OSRM-compatible server). The public demo server has NO live traffic and a fair-use policy:
# run your own OSRM (or use a commercial provider) for production.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=5000
ROUTING_CACHE_TTL_SEC=120

# Only used by `npm run create-admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin123@gmail.com
